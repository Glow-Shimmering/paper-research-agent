# LLM API 配置（OpenAI 兼容；DeepSeek / OpenAI / 通义等均可）
PRA_LLM_BASE_URL=https://api.deepseek.com
# 留空则问答功能退回纯检索模式
PRA_LLM_API_KEY=
PRA_LLM_MODEL=deepseek-v4-flash

# Web 远程监听鉴权（非 loopback 时必须设置；请求头 X-PRA-Key）
# PRA_WEB_API_KEY=

# 发现来源（Semantic Scholar key 可选；Crossref email 用于 polite pool）
# PRA_SEMANTIC_SCHOLAR_API_KEY=
# PRA_CROSSREF_EMAIL=you@example.com

# 普通网页抓取硬限制（HTML bytes、总超时秒数、最大重定向次数）
# PRA_WEB_FETCH_MAX_BYTES=10485760
# PRA_WEB_FETCH_TIMEOUT_SECONDS=20
# PRA_WEB_FETCH_MAX_REDIRECTS=5

# 嵌入模型（首次索引时联网下载，缓存于本地）
PRA_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 独立数据目录（默认 ~/.pragent；旧 Pagent 数据不会被自动读取）
# PRA_DATA_DIR=

# 论文下载目录（不设时使用显式 PRA_DATA_DIR，否则使用已索引论文库目录）
# PRA_DOWNLOAD_DIR=

# 笔记保存目录（工具 save_note 与 /export 的保存位置；默认 PRA_DATA_DIR/notes）
# PRA_NOTE_DIR=

# 国内下载模型慢时取消注释（HuggingFace 镜像）
# HF_ENDPOINT=https://hf-mirror.com
# hf-mirror 不支持 Xet 存储；使用镜像时必须同时取消注释下行（否则模型下载 401 失败）
# HF_HUB_DISABLE_XET=1
