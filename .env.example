# LLM API 配置（OpenAI 兼容；DeepSeek / OpenAI / 通义等均可）
PAPER_LLM_BASE_URL=https://api.deepseek.com
# 留空则问答功能退回纯检索模式
PAPER_LLM_API_KEY=
PAPER_LLM_MODEL=deepseek-chat

# Web 远程监听鉴权（非 loopback 时必须设置；请求头 X-Paper-Agent-Key）
# PAPER_WEB_API_KEY=

# 嵌入模型（首次索引时联网下载，缓存于本地）
PAPER_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 数据库目录（默认 ~/.paper-agent）
# PAPER_DATA_DIR=

# 论文下载目录（不设时使用显式 PAPER_DATA_DIR，否则使用已索引论文库目录）
# PAPER_DOWNLOAD_DIR=

# 笔记保存目录（工具 save_note 与 /export 的保存位置；默认 PAPER_DATA_DIR/notes）
# PAPER_NOTE_DIR=

# 国内下载模型慢时取消注释（HuggingFace 镜像）
# HF_ENDPOINT=https://hf-mirror.com
# hf-mirror 不支持 Xet 存储；使用镜像时必须同时取消注释下行（否则模型下载 401 失败）
# HF_HUB_DISABLE_XET=1
